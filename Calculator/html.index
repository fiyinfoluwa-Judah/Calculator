
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apple Style Calculator</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #171717;
            font-family: -apple-system, BlinkMacSystemFont,
                         "Segoe UI", sans-serif;
        }

        .calculator {
            width: 350px;
            max-width: 95vw;
            padding: 25px 20px 22px;
            border-radius: 40px;
            background: #000;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.6);
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #888;
            font-size: 12px;
            margin: 0 5px;
        }

        .display {
            height: 145px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            align-items: flex-end;
            padding: 15px 5px 20px;
            overflow: hidden;
        }

        .previous {
            min-height: 24px;
            color: #777;
            font-size: 18px;
            margin-bottom: 8px;
            word-break: break-all;
            text-align: right;
        }

        .current {
            color: white;
            font-size: 65px;
            font-weight: 300;
            line-height: 1.1;
            max-width: 100%;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: none;
        }

        .current::-webkit-scrollbar {
            display: none;
        }

        .buttons {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        button {
            width: 100%;
            aspect-ratio: 1;
            border: none;
            border-radius: 50%;
            background: #333333;
            color: white;
            font-size: 27px;
            font-weight: 400;
            cursor: pointer;
            transition: filter 0.12s, transform 0.12s;
            -webkit-tap-highlight-color: transparent;
        }

        button:active {
            filter: brightness(1.5);
            transform: scale(0.94);
        }

        .utility {
            background: #a5a5a5;
            color: #000;
        }

        .operator {
            background: #ff9f0a;
            color: white;
            font-size: 32px;
        }

        .operator.selected {
            background: white;
            color: #ff9f0a;
        }

        .zero {
            grid-column: span 2;
            aspect-ratio: auto;
            border-radius: 50px;
            text-align: left;
            padding-left: 28px;
        }

        .footer {
            text-align: center;
            color: #555;
            font-size: 11px;
            margin-top: 20px;
            letter-spacing: 1px;
        }

        @media (max-width: 380px) {
            .calculator {
                padding: 20px 15px;
            }

            .buttons {
                gap: 8px;
            }

            button {
                font-size: 24px;
            }

            .current {
                font-size: 56px;
            }
        }
    </style>
</head>

<body>

    <main class="calculator">
        <div class="top-bar">
            <span>CALCULATOR</span>
            <span>● ● ●</span>
        </div>

        <section class="display" aria-live="polite">
            <div class="previous" id="previous"></div>
            <div class="current" id="current">0</div>
        </section>

        <section class="buttons">
            <button class="utility" data-action="clear">AC</button>
            <button class="utility" data-action="sign">+/−</button>
            <button class="utility" data-action="percent">%</button>
            <button class="operator" data-op="÷">÷</button>

            <button data-number="7">7</button>
            <button data-number="8">8</button>
            <button data-number="9">9</button>
            <button class="operator" data-op="×">×</button>

            <button data-number="4">4</button>
            <button data-number="5">5</button>
            <button data-number="6">6</button>
            <button class="operator" data-op="−">−</button>

            <button data-number="1">1</button>
            <button data-number="2">2</button>
            <button data-number="3">3</button>
            <button class="operator" data-op="+">+</button>

            <button class="zero" data-number="0">0</button>
            <button data-action="decimal">.</button>
            <button class="operator" data-action="equals">=</button>
        </section>

        <div class="footer">DESIGNED FOR EVERYDAY MATH</div>
    </main>

    <script>
        const currentDisplay = document.getElementById("current");
        const previousDisplay = document.getElementById("previous");
        const buttons = document.querySelector(".buttons");

        let currentValue = "0";
        let storedValue = null;
        let operator = null;
        let waitingForOperand = false;
        let justCalculated = false;

        function updateDisplay() {
            currentDisplay.textContent = currentValue;

            const length = currentValue.length;
            currentDisplay.style.fontSize =
                length > 10 ? "34px" :
                length > 7 ? "45px" : "65px";

            previousDisplay.textContent =
                storedValue !== null && operator
                    ? `${storedValue} ${operator}`
                    : "";
        }

        function clearCalculator() {
            currentValue = "0";
            storedValue = null;
            operator = null;
            waitingForOperand = false;
            justCalculated = false;
            clearSelectedOperator();
            updateDisplay();
            document.querySelector('[data-action="clear"]').textContent = "AC";
        }

        function clearSelectedOperator() {
            document.querySelectorAll(".operator").forEach(button => {
                button.classList.remove("selected");
            });
        }

        function inputNumber(number) {
            if (currentValue === "Error") clearCalculator();

            if (waitingForOperand || justCalculated) {
                currentValue = number;
                waitingForOperand = false;
                justCalculated = false;
                clearSelectedOperator();
            } else if (currentValue === "0") {
                currentValue = number;
            } else if (currentValue.length < 15) {
                currentValue += number;
            }

            updateDisplay();
            document.querySelector('[data-action="clear"]').textContent = "C";
        }

        function inputDecimal() {
            if (currentValue === "Error") clearCalculator();

            if (waitingForOperand || justCalculated) {
                currentValue = "0.";
                waitingForOperand = false;
                justCalculated = false;
            } else if (!currentValue.includes(".")) {
                currentValue += ".";
            }

            clearSelectedOperator();
            updateDisplay();
        }

        function formatNumber(number) {
            if (!Number.isFinite(number)) return "Error";
            if (Object.is(number, -0)) return "0";

            return Number(number.toPrecision(12)).toString();
        }

        function calculate(a, b, op) {
            switch (op) {
                case "+": return a + b;
                case "−": return a - b;
                case "×": return a * b;
                case "÷": return b === 0 ? NaN : a / b;
                default: return b;
            }
        }

        function chooseOperator(nextOperator) {
            if (currentValue === "Error") return;

            const inputValue = Number(currentValue);

            if (operator && !waitingForOperand) {
                const result = calculate(
                    storedValue,
                    inputValue,
                    operator
                );

                currentValue = formatNumber(result);

                if (currentValue === "Error") {
                    storedValue = null;
                    operator = null;
                    waitingForOperand = false;
                    clearSelectedOperator();
                    updateDisplay();
                    return;
                }

                storedValue = Number(currentValue);
            } else {
                storedValue = inputValue;
            }

            operator = nextOperator;
            waitingForOperand = true;
            justCalculated = false;

            clearSelectedOperator();

            const activeButton = [...document.querySelectorAll("[data-op]")]
                .find(button => button.dataset.op === nextOperator);

            if (activeButton) activeButton.classList.add("selected");

            updateDisplay();
        }

        function equals() {
            if (operator === null || storedValue === null ||
                waitingForOperand || currentValue === "Error") {
                return;
            }

            const first = storedValue;
            const second = Number(currentValue);
            const result = calculate(first, second, operator);

            previousDisplay.textContent =
                `${formatNumber(first)} ${operator} ${formatNumber(second)} =`;

            currentValue = formatNumber(result);
            storedValue = null;
            operator = null;
            waitingForOperand = false;
            justCalculated = true;

            clearSelectedOperator();
            updateDisplay();
        }

        function changeSign() {
            if (currentValue === "Error" || Number(currentValue) === 0) return;

            currentValue = formatNumber(-Number(currentValue));
            updateDisplay();
        }

        function percentage() {
            if (currentValue === "Error") return;

            currentValue = formatNumber(Number(currentValue) / 100);
            updateDisplay();
        }

        buttons.addEventListener("click", event => {
            const button = event.target.closest("button");
            if (!button) return;

            if (button.dataset.number !== undefined) {
                inputNumber(button.dataset.number);
                return;
            }

            if (button.dataset.op) {
                chooseOperator(button.dataset.op);
                return;
            }

            switch (button.dataset.action) {
                case "clear":
                    clearCalculator();
                    break;
                case "sign":
                    changeSign();
                    break;
                case "percent":
                    percentage();
                    break;
                case "decimal":
                    inputDecimal();
                    break;
                case "equals":
                    equals();
                    break;
            }
        });

        document.addEventListener("keydown", event => {
            const key = event.key;

            if (/^[0-9]$/.test(key)) {
                inputNumber(key);
            } else if (key === ".") {
                inputDecimal();
            } else if (key === "+") {
                chooseOperator("+");
            } else if (key === "-") {
                chooseOperator("−");
            } else if (key === "*") {
                chooseOperator("×");
            } else if (key === "/") {
                event.preventDefault();
                chooseOperator("÷");
            } else if (key === "Enter" || key === "=") {
                event.preventDefault();
                equals();
            } else if (key === "Escape") {
                clearCalculator();
            } else if (key === "Backspace") {
                if (!waitingForOperand && currentValue !== "Error") {
                    currentValue = currentValue.length > 1
                        ? currentValue.slice(0, -1)
                        : "0";

                    if (currentValue === "-") currentValue = "0";
                    updateDisplay();
                }
            } else if (key === "%") {
                percentage();
            }
        });

        updateDisplay();
    </script>

</body>
</html>
